{
  "expo": {
    "name": "Statify",
    "slug": "statify",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/statify.png",
    "scheme": "statify",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/statify.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/images/statify.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.faidev04.statify"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0A",
          "image": "./assets/images/statify.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "372cb5e9-0a9b-4fda-b4cd-72a36e883520"
      }
    }
  }
}
